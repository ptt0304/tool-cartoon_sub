  "segments": [
    {
      "id": 1,
      "srt_index": 1,
      "start": 0.0,
      "end": 15.2,
      "duration": 15.2,
      "text": "Các ái khanh, năm trẫm hai mươi tám tuổi, anh em bị sát hại, phụ hoàng bị giam lỏng, một mình trẫm chống đỡ cả bầu trời Đại Đường. Chặng đường đã qua cũng coi như đạt được chút thành tựu mọn. Trẫm quyết định phong thiền Thái Sơn, mọi người nói xem có được không?",
      "text_file": "segments/000001.txt",
      "target_syllables": 53,
      "actual_syllables": 56,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 5,
      "srt_index": 2,
      "start": 24.8,
      "end": 27.0,
      "duration": 2.1999999999999993,
      "text": "Được rồi, được rồi, không phong nữa, không phong nữa, không phong nữa.",
      "text_file": "segments/000005.txt",
      "target_syllables": 8,
      "actual_syllables": 13,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 7,
      "srt_index": 3,
      "start": 33.0,
      "end": 37.0,
      "duration": 4.0,
      "text": "Ồ, đúng, đúng, đúng, phải thế chứ, trẫm muốn rửa tai lắng nghe.",
      "text_file": "segments/000007.txt",
      "target_syllables": 14,
      "actual_syllables": 13,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 8,
      "srt_index": 4,
      "start": 37.0,
      "end": 43.0,
      "duration": 6.0,
      "text": "Đã phong thiền hao dân tốn của thì thôi vậy. Trẫm sửa sang lại cung điện một chút, thế chắc là được chứ?",
      "text_file": "segments/000008.txt",
      "target_syllables": 21,
      "actual_syllables": 23,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 10,
      "srt_index": 5,
      "start": 46.5,
      "end": 47.5,
      "duration": 1.0,
      "text": "Hả?",
      "text_file": "segments/000010.txt",
      "target_syllables": 4,
      "actual_syllables": 1,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 12,
      "srt_index": 6,
      "start": 52.0,
      "end": 54.5,
      "duration": 2.5,
      "text": "Được rồi, được rồi, không sửa nữa, không sửa nữa, không sửa nữa. Khanh xem, lại nóng nảy rồi.",
      "text_file": "segments/000012.txt",
      "target_syllables": 9,
      "actual_syllables": 19,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 13,
      "srt_index": 7,
      "start": 55.5,
      "end": 59.5,
      "duration": 4.0,
      "text": "Đừng tức giận, cuộc đời như vở kịch, phải làm minh quân hoàng đế tốt.",
      "text_file": "segments/000013.txt",
      "target_syllables": 14,
      "actual_syllables": 15,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 14,
      "srt_index": 8,
      "start": 59.5,
      "end": 61.5,
      "duration": 2.0,
      "text": "Ngụy Trưng, ăn lạc đi.",
      "text_file": "segments/000014.txt",
      "target_syllables": 7,
      "actual_syllables": 5,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 16,
      "srt_index": 9,
      "start": 67.5,
      "end": 69.0,
      "duration": 1.5,
      "text": "Đừng ồn, trẫm đang suy nghĩ.",
      "text_file": "segments/000016.txt",
      "target_syllables": 5,
      "actual_syllables": 6,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 20,
      "srt_index": 10,
      "start": 80.5,
      "end": 82.5,
      "duration": 2.0,
      "text": "Tức chết ta rồi!",
      "text_file": "segments/000020.txt",
      "target_syllables": 7,
      "actual_syllables": 4,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 21,
      "srt_index": 11,
      "start": 82.5,
      "end": 91.0,
      "duration": 8.5,
      "text": "Ngụy Trưng đúng là cái đồ tiểu yêu tinh hành hạ người ta mà. Phòng Huyền Linh, ngươi đừng cản ta, trẫm hôm nay nhất định phải chém chết tên nhà quê đó!",
      "text_file": "segments/000021.txt",
      "target_syllables": 30,
      "actual_syllables": 33,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 22,
      "srt_index": 12,
      "start": 91.0,
      "end": 97.5,
      "duration": 6.5,
      "text": "Hừ, cũng tại trẫm tính khí tốt, chứ đổi lại là Chu Nguyên Chương, hắn giờ đã tan xương nát thịt rồi. Phải phạt nặng hắn mới được, một tháng không cho ăn rau cải bó xôi!",
      "text_file": "segments/000022.txt",
      "target_syllables": 23,
      "actual_syllables": 37,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    },
    {
      "id": 23,
      "srt_index": 13,
      "start": 97.5,
      "end": 105.5,
      "duration": 8.0,
      "text": "Haiz, thôi bỏ đi, chim gián tử thì cứ là chim gián tử vậy. Ngụy Trưng đúng là một dòng nước trong sạch, vừa có công tòng long, lại vừa có công huấn long. Cứ tùy tiện thăng chức cho hắn đi.",
      "text_file": "segments/000023.txt",
      "target_syllables": 28,
      "actual_syllables": 42,
      "overlap": false,
      "overlap_group": null,
      "translation_mode": "balanced_dubbing",
      "dubbing_status": "not_started",
      "semantic_compression": false
    }
